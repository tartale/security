# claude-sandbox settings, loaded by .envrc (source_env .envrc-cs). init.sh keeps the
# entries in alphabetical order and adds any that are missing; your values are kept.

# build.sh: Claude Code version baked into the image. Default: latest.
# export CLAUDE_VERSION=

# Container name. Default: cs-<repo-name> (run.sh appends -2, -3... while one is running); claude-sandbox.sh on its own adds a random suffix.
# export CS_CONTAINER_NAME=

# A docker config directory; its config.json (registry logins) is mounted read-only so the container's docker CLI can use them.
# Off by default: anything in the container can read the credentials. Logins held in a credential helper (credsStore, e.g. macOS Keychain) are not available.
# export CS_DOCKER_CONFIG=/var/services/homes/admin/.docker-sandbox

# Extra docker run flags, as one string, e.g. "-v /host/path:/container/path".
# --add-host works as in docker, including host-gateway. The container's /etc/hosts is docker's own, minus IPv6 localhost, so the host's hosts entries do not carry over.
# A --restart here replaces start.sh's --restart=unless-stopped.
# export CS_DOCKER_FLAGS=

# Env file passed into the container (docker --env-file). It is read as data and never run as shell.
export CS_ENV_FILE=.env

# Image repository, including registry host and namespace. build.sh and the launcher must use the same value.
export CS_IMAGE_REPO=ghcr.io/tartale/claude-sandbox

# Tag of this project's sandbox image: build.sh pushes it, run.sh and start.sh use it.
export CS_IMAGE_TAG=security

# Memory limit for the container (docker run --memory), e.g. 8g. Unset means no limit.
# export CS_MEMORY=

# Maximum number of processes in the container (docker run --pids-limit). Unset means no limit.
# export CS_PIDS_LIMIT=

# Launcher version: a commit, tag or branch of tartale/claude-sandbox. Overrides the commit init.sh pinned in .claude/sandbox/ref.
# Set to latest to follow main with no pin; init.sh then writes none and removes an existing one.
# export CS_REF=

# Your own checkout of the user config repo on the host, where sync.sh applies the sandbox's patch. The launcher does not read it.
# export CS_USER_CONFIG_CHECKOUT=$HOME/.claude-user

# build.sh: language version pins, space-separated <language>-<version>, e.g. "go-1.25.10". A plugin with no entry here installs the latest stable.
# export LANGUAGE_VERSIONS=
