#!/usr/bin/env bash
# Root CLI launcher. Creates the venv and installs the projects on first run and whenever a
# pyproject.toml changes (a new dependency), then hands off to the typer app.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
venv="${SECURITY_VENV:-$root/.venv}"
stamp="$venv/.installed"

stale=false
[[ -x "$venv/bin/security" && -f "$stamp" ]] || stale=true
for pyproject in "$root/pyproject.toml" "$root/credentials/rotator/pyproject.toml"; do
  if [[ "$pyproject" -nt "$stamp" ]]; then stale=true; fi
done

if [[ "$stale" == true ]]; then
  [[ -d "$venv" ]] || python3 -m venv "$venv"
  "$venv/bin/pip" install --quiet -e "$root/credentials/rotator[dev]" -e "$root[dev]"
  touch "$stamp"
fi

exec "$venv/bin/security" "$@"
